# ---------------------------------------------------------------------------
# EITAMS server environment (copy to server/.env and adjust locally)
# Never commit server/.env. All values are read by server/src/config/env.js.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# IANA zone used by Node and by every MySQL session (CURDATE/NOW).
# Numeric offsets such as +05:30 are rejected.
APP_TIMEZONE=Asia/Kolkata

# Database — Phase 2 schema, seed and verification use these values.
# database/schema.sql creates the default `eitams` schema; keep DB_NAME=eitams
# unless you also adjust the USE statement in the static SQL files.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eitams
DB_TEST_NAME=eitams_test

# Authentication — consumed from Phase 3 onwards. Use a long random value.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
